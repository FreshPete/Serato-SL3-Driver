+def owned_creation_time(process):
+    """Use Popen's retained Windows handle, including after an early exit."""
+    kernel = ctypes.WinDLL('kernel32', use_last_error=True)
+    kernel.GetProcessTimes.argtypes = (wintypes.HANDLE,) + (ctypes.POINTER(wintypes.FILETIME),) * 4
+    kernel.GetProcessTimes.restype = wintypes.BOOL
+    times = [wintypes.FILETIME() for _ in range(4)]
+    if not kernel.GetProcessTimes(int(process._handle), *(ctypes.byref(item) for item in times)):
+        raise ctypes.WinError(ctypes.get_last_error())
+    return str((times[0].dwHighDateTime << 32) | times[0].dwLowDateTime)
+
+
+def record_launch(process, controller, controller_sha, source, session, pointer, inspection):
+    record = {'schema':'sl3.diagnostic-controller-launch.v1','controllerPid':process.pid,
+              'controllerCreatedFileTime':owned_creation_time(process),'controllerSha256':controller_sha,
+              'controller':str(controller),'input':str(source),'inputSha256':digest(source),
+              'session':str(session),'pointer':str(pointer),'kind':inspection['kind']}
+    with session.with_suffix('.launch.json').open('x',encoding='utf-8') as stream:
+        json.dump(record,stream);stream.flush();os.fsync(stream.fileno())
+
